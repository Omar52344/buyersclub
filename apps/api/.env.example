NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5433/buyersclub
CORS_ORIGIN=http://localhost:8081
LOG_LEVEL=info
# Genera uno propio con: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-please-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
SMTP_URL=smtp://localhost:1025
MAIL_FROM="BuyersClub <no-reply@buyersclub.local>"
# Opcional: activa Google Geocoding y (más adelante) el mapa.
# GOOGLE_MAPS_API_KEY=tu-key
# En desarrollo devuelve el código OTP en la respuesta para probar sin correo.
# Nunca lo actives en producción.
EXPOSE_DEV_CODES=true

# Carpeta local de archivos (en producción: S3/R2).
UPLOAD_DIR=.uploads

# Almacenamiento S3/R2 opcional. Sin estas variables se usa la carpeta local.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=buyersclub-private
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test

# URL pública de la web/app para los enlaces QR.
PUBLIC_APP_URL=http://localhost:8081

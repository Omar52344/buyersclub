{
  "name": "buyersclub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @buyersclub/api",
    "dev:mobile": "npm run start --workspace @buyersclub/mobile",
    "web": "npm run web --workspace @buyersclub/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "services:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "npm run db:generate --workspace @buyersclub/api",
    "db:migrate": "npm run db:migrate --workspace @buyersclub/api",
    "db:setup": "npm run services:up && npm run db:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  }
}
